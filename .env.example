# banger-board — env template
# Copy to ~/.zshrc or ~/.bashrc (or source from a project-local .env)

# --- Required: API access ---
export UW_TOKEN=                  # https://unusualwhales.com/api
export FMP_API_KEY=               # https://financialmodelingprep.com/

# --- Optional: sentiment cross-check ---
export FINNHUB_API_KEY=           # signal #10; EXA fallback used if absent

# --- Required: companion repo paths ---
export RADON_PATH=                # /path/to/radon (IBKR flow-discover + 7-milestone gate)
export TRADE_REFRESH_PATH=        # /path/to/trade-refresh (backtest harness)

# --- Required: vault doc paths ---
export SLEEVE_LEDGER=             # /path/to/sleeve-ledger.md
export REGIME_DOC=                # /path/to/market-regime.md
